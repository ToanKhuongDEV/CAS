# Local backend runtime
DB_URL=jdbc:mysql://localhost:3306/cas?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=cas
DB_PASSWORD=replace-with-your-local-password
DB_POOL_SIZE=10
DB_MIN_IDLE=2

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

FRONTEND_ORIGIN=http://localhost:3000
SERVER_PORT=8080

# Absolute path to the Firebase service-account JSON. Never commit that JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/cas-firebase-service-account.json
